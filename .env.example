# ==============================================================================
# DHIS2 Tools — Modèle de configuration pour la base de données Statistiques
# ==============================================================================
#
# ⚠️ CE FICHIER N'EST QU'UN MODÈLE. Ne le renommez PAS en `.env` à cet endroit :
# tout fichier `.env` placé dans le dossier servi par le serveur web est
# potentiellement accessible en le demandant directement dans un navigateur.
#
# Le vrai fichier .env doit être copié et rempli HORS de ce dossier, par exemple :
#   /etc/dhis2-tools/.env
#
# Indiquez ensuite ce chemin dans api/env.php (méthode la plus simple pour démarrer,
# aucune configuration serveur nécessaire) :
#   define('DHIS2_TOOLS_ENV_PATH', '/etc/dhis2-tools/.env');
#
# Voir MODULE_STATISTIQUES.md pour cette procédure et pour la méthode avancée
# (variable d'environnement système, pour du déploiement scripté/CI).
# ==============================================================================

# Base de données PostgreSQL utilisée par api/stats.php et api/interactions.php
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dhis2_tools
DB_USER=dhis2_tools_app
DB_PASS=change-me

# Jeton d'accès à l'interface d'administration des statistiques (admin/stats.html).
# Obligatoire pour activer cette interface : tant qu'il est vide, l'API
# api/admin-modules.php refuse toutes les actions. Générez une valeur aléatoire, ex :
#   openssl rand -hex 24
ADMIN_TOKEN=
