# Excel Mapping - Git Ignore

# Uploaded files
uploads/*
!uploads/.gitkeep

# Exported files
exports/*
!exports/.gitkeep

# Saved mappings
saved_mappings/*
!saved_mappings/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
error_log

# Temporary files
*.tmp
*.temp

# PHP
vendor/
composer.lock

# Backup files
*.bak
*.backup

# Configuration sensible (le vrai fichier doit de toute façon vivre HORS de ce
# dossier — voir .env.example — mais on l'ignore aussi ici par sécurité)
.env
dhis2-tools.env
